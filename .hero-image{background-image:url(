/* =========================================
   THE LENNOX APARTMENTS
   PREMIUM LUXURY WEBSITE STYLESHEET
   NAVY • WHITE • CHAMPAGNE GOLD
========================================= */

:root {
  --navy: #102541;
  --navy-deep: #091a30;
  --navy-light: #183858;
  --gold: #c5a36b;
  --gold-light: #e5d1aa;
  --white: #ffffff;
  --soft-white: #f5f7fa;
  --cream: #f8f7f3;
  --text: #253247;
  --muted: #758092;
  --border: #e1e6ed;
  --shadow: 0 15px 45px rgba(16, 37, 65, 0.09);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 100px;
}

body {
  margin: 0;
  background: var(--white);
  color: var(--text);
  font-family: "DM Sans", Arial, sans-serif;
  line-height: 1.65;
}

img {
  max-width: 100%;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input,
select,
textarea {
  font: inherit;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

/* ANNOUNCEMENT */

.announcement {
  background: var(--navy-deep);
  color: var(--gold-light);
  text-align: center;
  padding: 11px 16px;
  font-size: 10px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
}

/* HEADER AND NAVIGATION */

.site-header {
  min-height: 88px;
  padding: 0 6.5%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--white);
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 3px 20px rgba(16, 37, 65, 0.07);
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  letter-spacing: 0.12em;
}

.brand-mark {
  width: 38px;
  height: 42px;
}

.brand strong,
.brand small {
  display: block;
}

.brand strong {
  color: var(--navy);
  font-size: 14px;
  line-height: 1.3;
  letter-spacing: 0.08em;
}

.brand small {
  font-size: 8px;
  letter-spacing: 0.2em;
  color: #a88956;
}

.main-nav {
  display: flex;
  align-items: center;
  gap: 30px;
  font-size: 12px;
  font-weight: 600;
}

.main-nav > a:not(.nav-cta) {
  color: var(--navy);
  transition: color 0.2s ease;
}

.main-nav > a:hover {
  color: var(--gold);
}

.nav-cta {
  background: var(--navy);
  color: var(--white);
  padding: 14px 22px;
  border-radius: 3px;
  transition: 0.25s ease;
}

.nav-cta span {
  color: var(--gold);
  margin-left: 10px;
}

.nav-cta:hover {
  background: var(--gold);
  color: var(--navy-deep);
}

.nav-cta:hover span {
  color: var(--navy);
}

.menu-toggle {
  display: none;
  border: 0;
  background: none;
  color: var(--navy);
  font-size: 25px;
  cursor: pointer;
}

/* HERO SECTION */

.hero {
  min-height: 690px;
  height: calc(100vh - 120px);
  max-height: 850px;
  position: relative;
  display: flex;
  align-items: center;
  color: var(--white);
  background: var(--navy-deep);
  overflow: hidden;
}

.hero-image,
.hero-shade {
  position: absolute;
  inset: 0;
}

.hero-image {
  background-image: url("assets/aerial-building.jpg");
  background-size: cover;
  background-position: center 55%;
  transform: scale(1.01);
}

.hero-shade {
  background: linear-gradient(
    90deg,
    rgba(7, 24, 45, 0.84) 0%,
    rgba(7, 24, 45, 0.48) 52%,
    rgba(7, 24, 45, 0.12) 100%
  );
}

.hero-content {
  position: relative;
  margin-left: 12%;
  max-width: 650px;
  padding: 70px 24px 90px 0;
  z-index: 2;
}

.eyebrow,
.section-kicker {
  font-size: 10px;
  letter-spacing: 0.22em;
  font-weight: 700;
  color: #a18455;
  text-transform: uppercase;
}

.eyebrow.light {
  color: var(--gold-light);
}

.hero h1,
h2 {
  font-family: "Playfair Display", Georgia, serif;
  font-weight: 500;
  line-height: 1.08;
  letter-spacing: -0.035em;
}

.hero h1 {
  font-size: clamp(58px, 7vw, 100px);
  margin: 24px 0;
  color: var(--white);
}

.hero h1 em,
h2 em {
  font-weight: 500;
  color: var(--gold);
}

.hero-copy {
  font-size: 15px;
  color: #e3e8ef;
  max-width: 420px;
}

.hero-actions {
  display: flex;
  align-items: center;
  gap: 28px;
  margin-top: 36px;
}

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 20px;
  padding: 16px 21px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.04em;
  border-radius: 3px;
  transition: all 0.25s ease;
}

.button:hover {
  transform: translateY(-2px);
}

.button-gold {
  background: var(--gold);
  color: var(--navy-deep);
}

.button-gold:hover {
  background: var(--white);
  color: var(--navy);
}

.button-dark {
  background: var(--navy);
  color: var(--white);
}

.button-dark:hover {
  background: var(--gold);
  color: var(--navy-deep);
}

.button-gold span,
.button-dark span {
  font-size: 17px;
}

.button-outline {
  border: 1px solid var(--gold);
  color: var(--navy);
}

.button-outline:hover {
  background: var(--navy);
  color: var(--white);
}

.text-link {
  display: inline-block;
  border-bottom: 1px solid var(--gold);
  padding-bottom: 5px;
  font-size: 11px;
  font-weight: 700;
  transition: color 0.2s ease;
}

.text-link:hover {
  color: var(--gold);
}

.light-link {
  color: var(--white);
  border-color: var(--gold-light);
}

.hero-caption {
  position: absolute;
  bottom: 34px;
  left: 6.5%;
  display: flex;
  align-items: center;
  gap: 14px;
  font-size: 9px;
  letter-spacing: 0.2em;
  color: #e4d6bd;
  z-index: 2;
}

.caption-line {
  width: 52px;
  height: 1px;
  background: var(--gold);
}

/* GENERAL SECTIONS */

.section-pad {
  padding: 110px 12%;
}

.intro,
.amenities,
.faq-section,
.contact {
  background: var(--white);
}

.intro-grid {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 10%;
  align-items: start;
}

.intro h2,
.section-heading h2,
.contact h2 {
  font-size: clamp(42px, 5vw, 65px);
  margin: 18px 0;
  color: var(--navy);
}

.intro-copy {
  padding-top: 20px;
  max-width: 480px;
}

.large-copy {
  font-family: "Playfair Display", Georgia, serif;
  font-size: 24px;
  color: #a18455;
  margin: 0 0 12px;
}

.intro-copy > p:not(.large-copy),
.feature-text > p:not(.eyebrow),
.residence-info p,
.section-heading > p,
.location-copy > p:not(.eyebrow),
.contact > p:not(.section-kicker) {
  font-size: 13px;
  color: var(--muted);
}

.intro-copy .text-link {
  margin-top: 20px;
}

/* FEATURE SECTION */

.feature-band {
  display: grid;
  grid-template-columns: 1.05fr 0.95fr;
  min-height: 500px;
  background: var(--soft-white);
}

.feature-photo {
  background: url("assets/IMG_0390.jpeg") center/cover;
  min-height: 400px;
}

.feature-text {
  padding: 90px 13%;
  align-self: center;
}

.feature-text h2,
.location-copy h2 {
  font: 500 clamp(38px, 4.5vw, 58px)/1.13 "Playfair Display", Georgia, serif;
  margin: 18px 0;
  color: var(--navy);
}

.feature-text > p:not(.eyebrow) {
  max-width: 370px;
  margin-bottom: 28px;
}

/* APARTMENT INTRO CARD */

.residence-card {
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  background: var(--white);
  box-shadow: var(--shadow);
}

.residence-image {
  min-height: 370px;
  background: url("assets/IMG_0391.jpeg") center/cover;
}

.residence-info {
  padding: 55px;
  align-self: center;
}

.card-index {
  font-size: 9px;
  letter-spacing: 0.2em;
  color: #a18455;
}

.residence-info h3 {
  font: 500 34px "Playfair Display", Georgia, serif;
  margin: 16px 0;
  color: var(--navy);
}

.residence-info p {
  margin-bottom: 25px;
}

.note {
  font-size: 10px;
  color: var(--muted);
  margin-top: 17px;
}

/* APARTMENT RATE CARDS */

.residences {
  background: var(--soft-white);
}

.residence-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 25px;
}

.section-heading {
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 50px;
  margin-bottom: 45px;
}

.section-heading > p {
  max-width: 310px;
  margin-bottom: 10px;
}

.rates-note {
  display: flex;
  gap: 16px;
  align-items: center;
  background: var(--white);
  border-left: 3px solid var(--gold);
  padding: 17px 20px;
  margin: -15px 0 28px;
  font-size: 11px;
  color: var(--muted);
}

.rates-note strong {
  color: var(--navy);
  white-space: nowrap;
}

.room-card {
  background: var(--white);
  min-width: 0;
  overflow: hidden;
  border-radius: 5px;
  box-shadow: 0 8px 30px rgba(16, 37, 65, 0.07);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.room-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 16px 40px rgba(16, 37, 65, 0.12);
}

.room-card > img {
  display: block;
  width: 100%;
  height: 270px;
  object-fit: cover;
  transition: transform 0.45s ease;
}

.room-card:hover > img {
  transform: scale(1.035);
}

.room-content {
  padding: 27px;
}

.room-topline {
  font-size: 9px;
  letter-spacing: 0.16em;
  font-weight: 700;
  color: #a18455;
}

.room-content h3 {
  font: 500 29px "Playfair Display", Georgia, serif;
  margin: 9px 0;
  color: var(--navy);
}

.room-content > p {
  font-size: 12px;
  line-height: 1.7;
  color: var(--muted);
  min-height: 62px;
}

.rate-options {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8px;
  margin-top: 20px;
}

.rate-choice {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 7px;
  padding: 12px 10px;
  min-height: 68px;
  background: var(--soft-white);
  border: 1px solid var(--border);
  border-radius: 3px;
  color: #5b554a;
  text-align: left;
  font: 500 10px "DM Sans", Arial, sans-serif;
  cursor: pointer;
  transition: 0.2s ease;
}

.rate-choice strong {
  font-size: 12px;
  color: var(--navy);
}

.rate-choice:hover,
.rate-choice:focus-visible,
.rate-choice.selected {
  border-color: var(--gold);
  background: #edf2f8;
  outline: none;
}

.rate-unavailable {
  grid-column: 1 / -1;
  font-size: 10px;
  color: var(--muted);
  padding: 9px 0;
}

.included-panel {
  margin-top: 28px;
  padding: 25px 28px;
  background: #edf1f6;
}

.included-panel h3 {
  font: 500 23px "Playfair Display", Georgia, serif;
  margin: 0 0 8px;
  color: var(--navy);
}

.included-panel p {
  font-size: 12px;
  line-height: 1.8;
  color: #6f7886;
  margin: 0;
}

/* GALLERY */

.gallery-section {
  background: var(--soft-white);
}

.gallery-grid {
  display: grid;
  grid-template-columns: 1.4fr 1fr;
  grid-template-rows: 220px 220px;
  gap: 14px;
}

.gallery-item {
  overflow: hidden;
  background: #e4e9ef;
}

.gallery-item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.5s ease;
}

.gallery-item:hover img {
  transform: scale(1.04);
}

.gallery-large {
  grid-row: span 2;
}

/* AMENITIES */

.amenity-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
}

.amenity-item {
  padding: 30px 24px 28px 0;
  border-right: 1px solid var(--border);
  margin-right: 24px;
}

.amenity-item:last-child {
  border: 0;
  margin-right: 0;
}

.amenity-icon {
  font: italic 20px "Playfair Display", Georgia, serif;
  color: var(--gold);
}

.amenity-item h3 {
  font: 500 21px "Playfair Display", Georgia, serif;
  margin: 15px 0 8px;
  color: var(--navy);
}

.amenity-item p {
  font-size: 12px;
  color: var(--muted);
  margin: 0;
}

/* BOOKING SECTION */

.booking-section {
  display: grid;
  grid-template-columns: 0.85fr 1.15fr;
  gap: 9%;
  background: #edf1f6;
  align-items: start;
}

.booking-intro h2 {
  font: 500 clamp(42px, 5vw, 65px)/1.08 "Playfair Display", Georgia, serif;
  margin: 18px 0;
  color: var(--navy);
}

.booking-intro > p:not(.section-kicker) {
  font-size: 13px;
  color: var(--muted);
  max-width: 400px;
}

.booking-assurance {
  display: flex;
  gap: 14px;
  margin-top: 27px;
  align-items: flex-start;
}

.booking-assurance > span {
  color: var(--gold);
}

.booking-assurance strong,
.booking-assurance small {
  display: block;
}

.booking-assurance strong {
  font-size: 12px;
  color: var(--navy);
}

.booking-assurance small {
  font-size: 11px;
  color: var(--muted);
  max-width: 290px;
}

.booking-form {
  background: var(--white);
  padding: 35px;
  border: 1px solid #e5e9ef;
  border-radius: 5px;
  box-shadow: var(--shadow);
}

.form-heading {
  display: flex;
  justify-content: space-between;
  gap: 15px;
  align-items: center;
  border-bottom: 1px solid var(--border);
  padding-bottom: 17px;
  margin-bottom: 22px;
}

.form-heading span {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.18em;
  color: var(--navy);
}

.form-heading small {
  font-size: 9px;
  color: var(--muted);
}

.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 17px;
}

.form-grid label {
  font-size: 10px;
  font-weight: 700;
  color: #575d67;
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.form-grid input,
.form-grid select,
.form-grid textarea {
  width: 100%;
  border: 1px solid #dce2e9;
  background: var(--white);
  padding: 13px 12px;
  border-radius: 3px;
  font: 400 12px "DM Sans", Arial, sans-serif;
  color: var(--text);
  min-height: 44px;
}

.form-grid textarea {
  resize: vertical;
}

.form-grid input:focus,
.form-grid select:focus,
.form-grid textarea:focus {
  outline: 2px solid var(--gold);
  outline-offset: 1px;
}

.full-field {
  grid-column: 1 / -1;
}

.form-submit {
  border: 0;
  cursor: pointer;
  margin-top: 16px;
}

.form-error {
  font-size: 11px;
  color: #9d342b;
  min-height: 0;
  margin: 8px 0 0;
}

.form-disclaimer {
  font-size: 9px;
  color: var(--muted);
  line-height: 1.5;
  margin: 14px 0 0;
}

/* PAYMENT STRIP */

.payment-strip {
  background: var(--navy-deep);
  color: var(--white);
  padding: 65px 12%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 35px;
}

.payment-strip h2 {
  font: 500 clamp(30px, 4vw, 46px)/1.12 "Playfair Display", Georgia, serif;
  margin: 10px 0;
  color: var(--white);
}

.payment-strip > div > p:last-child {
  font-size: 12px;
  color: #c4cbd5;
  max-width: 540px;
  margin: 0;
}

.payment-strip .eyebrow {
  margin: 0;
  color: var(--gold);
}

/* FAQ */

.faq-section {
  background: var(--white);
}

.faq-list {
  border-top: 1px solid var(--border);
}

.faq-list details {
  border-bottom: 1px solid var(--border);
  padding: 20px 0;
}

.faq-list summary {
  cursor: pointer;
  list-style: none;
  font: 500 20px "Playfair Display", Georgia, serif;
  display: flex;
  justify-content: space-between;
  gap: 20px;
  color: var(--navy);
}

.faq-list summary::-webkit-details-marker {
  display: none;
}

.faq-list summary:after {
  content: "+";
  font: 400 20px "DM Sans", sans-serif;
  color: var(--gold);
}

.faq-list details[open] summary:after {
  content: "−";
}

.faq-list details p {
  font-size: 12px;
  color: var(--muted);
  max-width: 720px;
  margin: 12px 0 0;
}

/* LOCATION */

.location-section {
  display: grid;
  grid-template-columns: 1fr 1fr;
  background: var(--navy-deep);
  color: var(--white);
  min-height: 570px;
}

.location-copy {
  padding: 90px 14%;
  align-self: center;
}

.location-copy h2 {
  color: var(--white);
}

.location-copy h2 em {
  color: var(--gold);
}

.location-copy > p:not(.eyebrow) {
  color: #c4cbd5;
  font-size: 13px;
  max-width: 380px;
}

.location-name {
  font-family: "Playfair Display", Georgia, serif;
  font-size: 23px !important;
  color: var(--gold-light) !important;
  margin: 28px 0 10px;
}

.location-copy .button {
  margin-top: 25px;
  background: var(--gold);
  color: var(--navy-deep);
}

.location-image {
  background: url("assets/IMG_0392.jpeg") center/cover;
  opacity: 1;
  min-height: 350px;
}

/* CONTACT */

.contact {
  text-align: center;
  padding-top: 105px;
  padding-bottom: 105px;
}

.contact h2 {
  font-size: clamp(48px, 6vw, 76px);
}

.contact > p:not(.section-kicker) {
  max-width: 430px;
  margin: 0 auto 28px;
}

.contact-actions {
  display: flex;
  justify-content: center;
  gap: 12px;
  flex-wrap: wrap;
}

.contact-number {
  display: block;
  margin-top: 17px;
  font-size: 11px;
  letter-spacing: 0.12em;
  color: var(--navy);
}

/* FOOTER */

.site-footer {
  background: var(--navy-deep);
  color: var(--white);
  padding: 45px 6.5% 20px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 35px;
}

.footer-brand .brand-mark {
  filter: brightness(1.2);
}

.footer-brand .brand strong {
  color: var(--white);
}

.footer-brand .brand small {
  color: var(--gold);
}

.footer-details {
  justify-self: end;
  display: flex;
  flex-direction: column;
  gap: 5px;
  text-align: right;
  font-size: 11px;
  color: #c4cbd5;
}

.footer-bottom {
  grid-column: 1 / -1;
  border-top: 1px solid #34465d;
  padding-top: 18px;
  display: flex;
  justify-content: space-between;
  font-size: 10px;
  color: #9ba7b7;
}

.footer-bottom a {
  color: var(--gold);
}

/* MOBILE BOOKING BAR */

.mobile-booking-bar {
  display: none;
}

/* IMAGE PRESENTATION */

.gallery-item img,
.room-card img {
  transition: transform 0.45s ease;
}

/* =========================================
   TABLET RESPONSIVE DESIGN
========================================= */

@media (max-width: 800px) {

  .site-header {
    min-height: 75px;
    padding: 0 6%;
  }

  .menu-toggle {
    display: block;
  }

  .main-nav {
    display: none;
    position: absolute;
    top: 75px;
    left: 0;
    right: 0;
    background: var(--white);
    padding: 20px 6% 26px;
    flex-direction: column;
    align-items: stretch;
    gap: 18px;
    box-shadow: 0 15px 20px rgba(0, 0, 0, 0.08);
  }

  .main-nav.open {
    display: flex;
  }

  .nav-cta {
    text-align: center;
  }

  .hero {
    min-height: 620px;
    height: 78vh;
  }

  .hero-content {
    margin-left: 8%;
    padding-right: 8%;
  }

  .hero h1 {
    font-size: clamp(54px, 12vw, 78px);
  }

  .hero-actions {
    align-items: flex-start;
    flex-direction: column;
    gap: 20px;
  }

  .section-pad {
    padding: 78px 8%;
  }

  .intro-grid,
  .feature-band,
  .residence-card,
  .location-section {
    grid-template-columns: 1fr;
  }

  .intro-grid {
    gap: 15px;
  }

  .feature-photo {
    min-height: 330px;
  }

  .feature-text {
    padding: 65px 8%;
  }

  .section-heading {
    display: block;
  }

  .section-heading > p {
    margin-top: 10px;
  }

  .residence-image {
    min-height: 290px;
  }

  .residence-info {
    padding: 35px;
  }

  .residence-grid {
    grid-template-columns: 1fr;
  }

  .room-card > img {
    height: 260px;
  }

  .room-content > p {
    min-height: 0;
  }

  .rates-note {
    align-items: flex-start;
    flex-direction: column;
    gap: 5px;
  }

  .amenity-grid {
    grid-template-columns: 1fr 1fr;
  }

  .amenity-item {
    padding: 23px 16px 22px 0;
    margin-right: 16px;
  }

  .amenity-item:nth-child(2) {
    border-right: 0;
    margin-right: 0;
  }

  .amenity-item:nth-child(3),
  .amenity-item:nth-child(4) {
    border-top: 1px solid var(--border);
  }

  .booking-section {
    grid-template-columns: 1fr;
    gap: 35px;
  }

  .booking-form {
    padding: 27px;
  }

  .payment-strip {
    padding: 55px 8%;
    align-items: flex-start;
    flex-direction: column;
  }

  .location-copy {
    padding: 70px 8%;
  }

  .location-image {
    min-height: 300px;
  }

  .site-footer {
    padding: 38px 8%;
  }

  .footer-details {
    font-size: 10px;
  }
}

/* =========================================
   MOBILE RESPONSIVE DESIGN
========================================= */

@media (max-width: 480px) {

  body {
    padding-bottom: 58px;
  }

  .announcement {
    font-size: 8px;
  }

  .hero {
    min-height: 590px;
  }

  .hero-content {
    margin-left: 7%;
  }

  .hero h1 {
    font-size: clamp(48px, 12vw, 65px);
    line-height: 1.08;
  }

  .hero-caption {
    left: 7%;
    font-size: 8px;
  }

  .section-pad {
    padding: 65px 7%;
  }

  .intro h2,
  .section-heading h2 {
    font-size: 43px;
  }

  .gallery-grid {
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 170px 140px;
    gap: 8px;
  }

  .gallery-large {
    grid-column: span 2;
    grid-row: auto;
  }

  .rate-options {
    gap: 6px;
  }

  .rate-choice {
    padding: 10px 7px;
    font-size: 9px;
  }

  .rate-choice strong {
    font-size: 10px;
  }

  .room-content {
    padding: 22px 18px;
  }

  .form-grid {
    grid-template-columns: 1fr;
  }

  .full-field {
    grid-column: auto;
  }

  .form-heading {
    align-items: flex-start;
    flex-direction: column;
  }

  .booking-form {
    padding: 22px 18px;
  }

  .contact {
    padding-top: 75px;
    padding-bottom: 75px;
  }

  .contact-actions {
    align-items: stretch;
    flex-direction: column;
  }

  .contact-actions .button {
    justify-content: center;
  }

  .site-footer {
    grid-template-columns: 1fr;
    gap: 22px;
  }

  .footer-details {
    justify-self: start;
    text-align: left;
  }

  .footer-bottom {
    gap: 15px;
    flex-wrap: wrap;
  }

  .mobile-booking-bar {
    position: fixed;
    z-index: 200;
    bottom: 0;
    left: 0;
    right: 0;
    display: grid;
    grid-template-columns: 1fr 100px;
    background: var(--navy-deep);
    padding: 9px 12px;
    gap: 8px;
    box-shadow: 0 -5px 18px rgba(0, 0, 0, 0.12);
  }

  .mobile-booking-bar a {
    text-align: center;
    padding: 10px;
    font-size: 11px;
    font-weight: 700;
    background: var(--gold);
    color: var(--navy-deep);
    border-radius: 3px;
  }

  .mobile-booking-bar a + a {
    background: var(--white);
  }
}

/* =========================================
   END OF THE LENNOX STYLESHEET

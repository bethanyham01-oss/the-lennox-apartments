/* =========================================
   THE LENNOX APARTMENTS
   PREMIUM BLACK & GOLD WEBSITE DESIGN
========================================= */

:root {
  --black: #080808;
  --black-deep: #030303;
  --charcoal: #151515;
  --charcoal-light: #202020;
  --gold: #c5a36b;
  --gold-light: #dfc493;
  --white: #ffffff;
  --muted: #bdbdbd;
  --border: rgba(197, 163, 107, 0.28);
  --heading-font: "Playfair Display", Georgia, serif;
  --body-font: "DM Sans", Arial, sans-serif;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 100px;
  background: var(--black);
}

body {
  margin: 0;
  background: var(--black) !important;
  color: var(--white);
  font-family: var(--body-font);
  font-size: 15px;
  line-height: 1.75;
  overflow-x: hidden;
}

img {
  max-width: 100%;
  display: block;
}

a {
  color: inherit;
  text-decoration: none;
  transition: color .3s ease;
}

button,
input,
select,
textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

section,
main {
  background-color: var(--black);
  color: var(--white);
}

.container,
.section-container {
  width: min(1160px, calc(100% - 48px));
  margin-inline: auto;
}

/* ANNOUNCEMENT BAR */

.announcement {
  background: var(--gold);
  color: var(--black);
  text-align: center;
  padding: 9px 15px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .16em;
  text-transform: uppercase;
}

/* HEADER */

.site-header {
  position: sticky;
  top: 0;
  z-index: 1000;
  width: 100%;
  background: rgba(3, 3, 3, .97);
  border-bottom: 1px solid var(--border);
  backdrop-filter: blur(14px);
}

.site-header .container,
.header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 82px;
  gap: 25px;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  color: var(--white);
  font-family: var(--heading-font);
  font-size: 21px;
  font-weight: 700;
  letter-spacing: .04em;
}

.brand img {
  width: 48px;
  height: 48px;
  object-fit: contain;
}

.main-nav {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 27px;
}

.main-nav a {
  color: #eeeeee;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: .06em;
  text-transform: uppercase;
}

.main-nav a:hover,
.main-nav a:focus {
  color: var(--gold);
}

.main-nav .nav-cta,
.nav-cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12px 21px;
  background: var(--gold);
  color: var(--black);
  border: 1px solid var(--gold);
  font-weight: 700;
}

.menu-toggle {
  display: none;
  border: 1px solid var(--gold);
  background: transparent;
  color: var(--gold);
  padding: 9px 13px;
  font-size: 22px;
}

/* HERO */

.hero {
  position: relative;
  min-height: 690px;
  display: flex;
  align-items: center;
  overflow: hidden;
  background: var(--black);
}

.hero-image {
  position: absolute;
  inset: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  min-height: 690px;
  background-image:
    linear-gradient(
      90deg,
      rgba(0, 0, 0, .86) 0%,
      rgba(0, 0, 0, .53) 55%,
      rgba(0, 0, 0, .32) 100%
    ),
    url("assets/aerial-building.jpg");
  background-position: center;
  background-size: cover;
  background-repeat: no-repeat;
}

.hero-shade {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: linear-gradient(
    0deg,
    rgba(0, 0, 0, .72),
    transparent 65%
  );
  pointer-events: none;
}

.hero-content {
  position: relative;
  z-index: 2;
  width: min(1160px, calc(100% - 48px));
  margin: auto;
  padding: 100px 0;
}

.hero-content h1,
.hero h1 {
  max-width: 850px;
  margin: 15px 0 22px;
  color: var(--white);
  font-family: var(--heading-font);
  font-size: clamp(46px, 7vw, 88px);
  font-weight: 700;
  line-height: 1.06;
  letter-spacing: -.035em;
}

.hero-content p,
.hero p {
  max-width: 580px;
  color: #e5e5e5;
  font-size: 17px;
  line-height: 1.8;
}

.hero-eyebrow,
.eyebrow,
.section-label {
  color: var(--gold);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .22em;
  text-transform: uppercase;
}

.hero-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  margin-top: 32px;
}

/* BUTTONS */

.button,
.btn,
button,
.form-submit {
  transition: all .25s ease;
}

.button,
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 49px;
  padding: 13px 25px;
  background: var(--gold);
  color: var(--black);
  border: 1px solid var(--gold);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: .09em;
  text-transform: uppercase;
}

.button:hover,
.btn:hover,
.form-submit:hover {
  background: var(--white);
  border-color: var(--white);
  color: var(--black);
}

.button-outline {
  background: transparent;
  color: var(--white);
  border: 1px solid var(--gold);
}

.button-outline:hover {
  background: var(--gold);
  color: var(--black);
}

/* GENERAL SECTIONS */

section {
  padding: 100px 0;
}

section h2 {
  margin: 0 0 22px;
  color: var(--gold);
  font-family: var(--heading-font);
  font-size: clamp(34px, 5vw, 57px);
  font-weight: 700;
  line-height: 1.18;
}

section h3 {
  color: var(--white);
  font-family: var(--heading-font);
  font-size: 25px;
  line-height: 1.3;
}

section p {
  color: var(--muted);
}

.section-heading {
  max-width: 760px;
  margin: 0 auto 55px;
  text-align: center;
}

.section-heading p {
  max-width: 620px;
  margin: 0 auto;
}

/* INTRODUCTION */

.intro-section {
  background: var(--black);
}

.intro-section .container {
  max-width: 900px;
  text-align: center;
}

.intro-section p {
  font-size: 16px;
}

/* FEATURED RESIDENCE */

.residence-section {
  background: #101010;
}

.residence-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 35px;
  align-items: center;
}

.residence-grid img {
  width: 100%;
  height: 430px;
  object-fit: cover;
}

.residence-grid h2 {
  text-align: left;
}

/* APARTMENT RATE CARDS */

.rates-section,
.apartments-section {
  background: var(--black);
}

.rooms-grid,
.rates-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 24px;
}

.room-card,
.rate-card {
  overflow: hidden;
  background: var(--charcoal);
  border: 1px solid var(--border);
  border-radius: 5px;
  transition: transform .3s ease, border-color .3s ease;
}

.room-card:hover,
.rate-card:hover {
  transform: translateY(-5px);
  border-color: var(--gold);
}

.room-card img,
.rate-card img {
  width: 100%;
  height: 235px;
  object-fit: cover;
}

.room-card-content,
.rate-card-content {
  padding: 25px;
}

.room-card h3,
.rate-card h3 {
  margin: 0 0 12px;
  color: var(--gold);
}

.room-card p,
.rate-card p {
  color: var(--muted);
  font-size: 14px;
}

.room-card .price,
.rate-card .price {
  color: var(--gold);
  font-size: 25px;
  font-weight: 700;
}

.rate-choice {
  display: block;
  width: 100%;
  margin-top: 12px;
  padding: 13px;
  background: #202020;
  color: var(--white);
  border: 1px solid var(--border);
  border-radius: 3px;
  text-align: left;
}

.rate-choice:hover,
.rate-choice.active {
  background: var(--gold);
  color: var(--black);
}

/* GALLERY */

.gallery-section {
  background: #101010;
}

.gallery-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 15px;
}

.gallery-grid img {
  width: 100%;
  height: 270px;
  object-fit: cover;
  transition: transform .4s ease;
}

.gallery-grid img:hover {
  transform: scale(1.025);
}

/* AMENITIES */

.amenities-section {
  background: var(--black);
}

.amenities-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
}

.amenity-card,
.feature-card {
  padding: 28px;
  background: var(--charcoal);
  border: 1px solid var(--border);
}

.amenity-card h3,
.feature-card h3 {
  color: var(--gold);
  font-size: 21px;
}

.amenity-card p,
.feature-card p {
  color: var(--muted);
}

/* BOOKING */

.booking-section {
  background: #101010;
}

.booking-form {
  max-width: 850px;
  margin: 0 auto;
  padding: 35px;
  background: var(--charcoal);
  border: 1px solid var(--border);
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px;
}

.booking-form label {
  display: block;
  margin-bottom: 7px;
  color: var(--gold-light);
  font-size: 12px;
  font-weight: 700;
}

.booking-form input,
.booking-form select,
.booking-form textarea {
  width: 100%;
  min-height: 48px;
  padding: 12px 14px;
  background: #090909;
  color: var(--white);
  border: 1px solid #494949;
  border-radius: 2px;
  outline: none;
}

.booking-form input:focus,
.booking-form select:focus,
.booking-form textarea:focus {
  border-color: var(--gold);
}

.booking-form textarea {
  min-height: 120px;
  resize: vertical;
}

.booking-form input::placeholder,
.booking-form textarea::placeholder {
  color: #999999;
}

.form-submit {
  width: 100%;
  min-height: 50px;
  margin-top: 20px;
  background: var(--gold);
  color: var(--black);
  border: 1px solid var(--gold);
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;
}

.form-error {
  color: #ff8585;
  font-size: 13px;
}

/* PAYMENT */

.payment-strip {
  padding: 25px;
  background: #080808;
  border-block: 1px solid var(--border);
  text-align: center;
}

.payment-strip p {
  color: var(--muted);
}

/* FAQ */

.faq-section {
  background: var(--black);
}

.faq-item {
  padding: 22px 0;
  border-bottom: 1px solid var(--border);
}

.faq-item h3 {
  color: var(--gold);
  font-size: 20px;
}

.faq-item p {
  color: var(--muted);
}

/* LOCATION AND CONTACT */

.location-section,
.contact-section {
  background: #101010;
}

.location-section iframe {
  width: 100%;
  min-height: 350px;
  border: 0;
  filter: grayscale(100%);
}

.contact-section a {
  color: var(--gold);
}

.contact-section a:hover {
  color: var(--white);
}

/* FOOTER */

.site-footer {
  padding: 65px 0 30px;
  background: var(--black-deep);
  color: var(--white);
  border-top: 1px solid var(--border);
}

.site-footer h3 {
  color: var(--gold);
}

.site-footer p,
.site-footer li {
  color: var(--muted);
}

.site-footer a {
  color: var(--gold-light);
}

.site-footer a:hover {
  color: var(--white);
}

/* MOBILE BOOKING BAR */

.mobile-booking-bar {
  display: none;
}

/* TEXT AND ACCENTS */

strong,
.price,
.section-label,
.eyebrow {
  color: var(--gold);
}

hr {
  border: 0;
  border-top: 1px solid var(--border);
}

/* TABLET */

@media (max-width: 950px) {
  .main-nav {
    gap: 15px;
  }

  .main-nav a {
    font-size: 10px;
  }

  .rooms-grid,
  .rates-grid,
  .amenities-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

/* MOBILE */

@media (max-width: 768px) {
  .container,
  .section-container {
    width: calc(100% - 36px);
  }

  section {
    padding: 70px 0;
  }

  .site-header .container,
  .header-inner {
    min-height: 70px;
  }

  .brand {
    font-size: 17px;
  }

  .brand img {
    width: 40px;
    height: 40px;
  }

  .menu-toggle {
    display: block;
  }

  .main-nav {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    padding: 12px 22px 22px;
    background: #050505;
    border-bottom: 1px solid var(--gold);
  }

  .main-nav.open {
    display: flex;
  }

  .main-nav a {
    padding: 13px 5px;
    border-bottom: 1px solid rgba(255,255,255,.08);
    font-size: 12px;
  }

  .main-nav .nav-cta {
    margin-top: 12px;
    text-align: center;
  }

  .hero {
    min-height: 590px;
  }

  .hero-image {
    min-height: 590px;
    background-position: center;
  }

  .hero-content {
    width: calc(100% - 36px);
    padding: 80px 0;
  }

  .hero-content h1,
  .hero h1 {
    font-size: clamp(43px, 12vw, 62px);
  }

  .hero-content p,
  .hero p {
    font-size: 15px;
  }

  section h2 {
    font-size: clamp(32px, 9vw, 43px);
  }

  .residence-grid,
  .rooms-grid,
  .rates-grid,
  .amenities-grid,
  .gallery-grid {
    grid-template-columns: 1fr;
  }

  .residence-grid img {
    height: 290px;
  }

  .room-card img,
  .rate-card img {
    height: 230px;
  }

  .gallery-grid img {
    height: 260px;
  }

  .form-grid {
    grid-template-columns: 1fr;
  }

  .booking-form {
    padding: 22px;
  }

  .hero-buttons {
    flex-direction: column;
    align-items: stretch;
  }

  .hero-buttons .button {
    width: 100%;
  }

  .mobile-booking-bar {
    position: fixed;
    display: block;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 999;
    padding: 12px 18px;
    background: rgba(0,0,0,.97);
    border-top: 1px solid var(--gold);
    text-align: center;
  }

  .mobile-booking-bar a {
    display: block;
    padding: 12px;
    background: var(--gold);
    color: var(--black);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  body {
    padding-bottom: 65px;
  }
}

/* SMALL PHONES */

@media (max-width: 380px) {
  .hero-content h1,
  .hero h1 {
    font-size: 39px;
  }

  .brand {
    font-size: 15px;
  }
}
